{
  "expo": {
    "name": "Let It Rain",
    "slug": "letitrain-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.letitrain.mobile",
      "buildNumber": "7",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Let It Rain uses Face ID to quickly and securely unlock the app."
      }
    },
    "android": {
      "package": "com.letitrain.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing",
      "sentry-expo"
    ],
    "scheme": "letitrain",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63265b99-54b8-4e41-933c-6b3f98d5e167"
      }
    },
    "owner": "obsidianstudio"
  }
}
