# For local development with Expo Go, point this at your machine's LAN IP
# (not localhost — a phone on Expo Go is a separate device on the network).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# For EAS builds (development/preview/production), the equivalent value is
# set per-profile in eas.json instead of this file. iOS App Transport
# Security blocks plain HTTP in a standalone (non-Expo-Go) build, so the
# preview/production profiles in eas.json MUST point at an https:// URL —
# your deployed web app's URL, not a LAN IP.
#
# Sentry DSN for crash/error monitoring. Get yours at https://sentry.io
# Leave empty to disable Sentry in development.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENVIRONMENT=development
