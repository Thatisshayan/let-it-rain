// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  permissions  String[] @default(["MANAGE_USERS", "DELETE_ITEMS", "EDIT_ITEMS", "ADJUST_STOCK", "MANAGE_ORDERS"])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  movements      Movement[]
  createdOrders  Order[]   @relation("OrderCreatedBy")
  driverOrders   Order[]   @relation("OrderDriver")
}

model Item {
  id          String   @id @default(uuid())
  name        String
  category    String?
  description String?
  quantity    Int      @default(0)
  minStock    Int      @default(0)
  customFields Json?
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  movements      Movement[]
  orderLineItems OrderLineItem[]

  @@index([name])
  @@index([deletedAt])
}

enum MovementType {
  RECEIVE
  REMOVE
  ADJUST
}

model Movement {
  id        String       @id @default(uuid())
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  type      MovementType
  delta     Int
  quantityAfter Int
  reason    String?
  isSale    Boolean      @default(false)
  cashAmount    Decimal? @db.Decimal(12, 2)
  interacAmount Decimal? @db.Decimal(12, 2)
  unitCostAtTime  Decimal? @db.Decimal(12, 2)
  unitPriceAtTime Decimal? @db.Decimal(12, 2)
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime     @default(now())

  @@index([itemId])
  @@index([createdAt])
  @@index([isSale, createdAt])
}

enum OrderStatus {
  PENDING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id               String        @id @default(uuid())
  customerName     String
  customerAddress  String?
  customerPhone    String?
  status           OrderStatus   @default(PENDING)
  notes            String?
  createdBy        User          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById      String
  driver           User?         @relation("OrderDriver", fields: [driverId], references: [id])
  driverId         String?
  lineItems        OrderLineItem[]
  createdAt        DateTime      @default(now())
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?

  @@index([status])
  @@index([driverId])
}

model OrderLineItem {
  id       String @id @default(uuid())
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  item     Item   @relation(fields: [itemId], references: [id])
  itemId   String
  quantity Int

  @@index([orderId])
}
