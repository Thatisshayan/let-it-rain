# Database — PostgreSQL (Neon recommended)
DATABASE_URL="postgresql://user:password@ep-example-pooler.c.region.aws.neon.tech/db?sslmode=require"
# Direct (unpooled) connection for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-example.c.region.aws.neon.tech/db?sslmode=require"

# Session signing key — generate with: openssl rand -base64 32
SESSION_SECRET="your-secret-at-least-32-chars-long"

# Rate limiting — Upstash Redis (optional; falls back to in-memory Map)
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"
