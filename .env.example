# Database — PostgreSQL (Neon recommended)
DATABASE_URL="postgresql://user:password@ep-example-pooler.c.region.aws.neon.tech/db?sslmode=require"
# Direct (unpooled) connection for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-example.c.region.aws.neon.tech/db?sslmode=require"

# Session signing key — generate with: openssl rand -base64 32
SESSION_SECRET="your-secret-at-least-32-chars-long"

# Canonical app origin used in absolute links (email verification, billing redirects).
# Internal-launch deploys should point this at the real internal URL.
APP_URL="http://localhost:3000"

# Platform operator bootstrap secret for /api/v1/admin/organizations.
# Leave unset unless you intentionally need the admin org-provisioning endpoint.
# PLATFORM_ADMIN_TOKEN="set-a-long-random-secret"

# Public self-serve signup switch.
# Internal launch should leave this unset or set it to "false".
# Phase 16/public rollout can opt in with "true".
# PUBLIC_SIGNUP_ENABLED="false"

# Rate limiting — Upstash Redis (optional; falls back to in-memory Map)
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"
